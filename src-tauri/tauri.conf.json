{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude 中文化工具",
  "version": "0.1.0",
  "identifier": "com.mapleeve.claude-zhcn-rust",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude 中文化工具",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Claude Code CLI 与 Claude Desktop 中文化工具"
  }
}
