{
  "name": "claude-zhcn-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test",
    "check:public": "bun scripts/check-public-surface.ts",
    "check:versions": "bun scripts/verify-versions.ts",
    "check:release-config": "bun scripts/check-release-config.ts",
    "check": "bun run typecheck && bun run test && bun run check:public && bun run check:versions && bun run check:release-config",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
